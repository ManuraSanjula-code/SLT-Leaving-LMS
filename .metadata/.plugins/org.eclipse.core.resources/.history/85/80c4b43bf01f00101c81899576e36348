    public static UserDto transformToUserDto(UserEntity userEntity) {
        if (userEntity == null) {
            return null;
        }

        UserDto userDto = new UserDto();
        userDto.setId(userEntity.getId());
        userDto.setUserId(userEntity.getUserId());
        userDto.setFirstName(userEntity.getFirstName());
        userDto.setLastName(userEntity.getLastName());
        userDto.setEmail(userEntity.getEmail());
        userDto.setEmployeeId(userEntity.getEmployeeId());
        userDto.setSltId(userEntity.getSltId());
        userDto.setEncryptedPassword(userEntity.getEncryptedPassword());
        userDto.setProfilePic(userEntity.getProfilePic());
        userDto.setEmailVerificationToken(userEntity.getEmailVerificationToken());
        userDto.setEmailVerificationStatus(userEntity.getEmailVerificationStatus());
        userDto.setAddresses(userEntity.getAddresses().stream()
                .map(addressEntity -> {
                    AddressDTO addressDTO = new AddressDTO();
                    addressDTO.setId(addressEntity.getId());
                    addressDTO.setAddressId(addressEntity.getAddressId());
                    addressDTO.setCity(addressEntity.getCity());
                    addressDTO.setCountry(addressEntity.getCountry());
                    addressDTO.setStreetName(addressEntity.getStreetName());
                    addressDTO.setPostalCode(addressEntity.getPostalCode());
                    addressDTO.setIsDefault(addressEntity.getIsDefault());
                    return addressDTO;
                })
                .collect(Collectors.toList()));
        userDto.setRoles(userEntity.getRoles().stream()
                .map(RoleEntity::getName)
                .collect(Collectors.toList()));
        userDto.setAuthorities(userEntity.getRoles().stream()
                .flatMap(roleEntity -> roleEntity.getAuthorities().stream())
                .map(AuthorityEntity::getName)
                .collect(Collectors.toList()));
        userDto.setSections(userEntity.getSections().stream()
                .map(SectionEntity::getSection)
                .collect(Collectors.toList()));
        userDto.setProfiles(userEntity.getProfiles().stream()
                .map(ProfilesEntity::getName)
                .collect(Collectors.toList()));
        userDto.setIsSltEmp(userEntity.getIsSltEmp());
        userDto.setIsSltIntern(userEntity.getIsSltIntern());
        userDto.setActive(userEntity.getActive());
        userDto.setPhone(userEntity.getPhone());
        userDto.setGender(userEntity.getGender());
        userDto.setRoaster(userEntity.getRoaster());

        return userDto;
    }

